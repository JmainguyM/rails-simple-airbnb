
<div class="container mt-3">
  <div class="row">
    <div class="col-12">
      <h1>All our Flats</h1>
    </div>
  </div>

  <div class="row">

    <div class="col">
        <p>All 2 flats.</p>
    </div>
  </div>

  <div class="row">
    <% @flats.each do |flat|  %>
      <div class="col-md-4">
        <div class="flat-card">
          <div class="flat-card-content">
            <div class="flat-card-title">
              <h4><%= flat.name %></h4>
            </div>
            <p><%= flat.address %></p>
            <div class="flex">
              <div class="flex align-items-center">
                <i class="fa-solid fa-people-line"></i>
                <span><%= flat.number_of_guest %></span>
              </div>
              <div class="flex align-items-center ms-3">
                <span><%= flat.price_per_night %></span>
                <i class="fa-solid fa-euro-sign"></i>
              </div>
            </div>
          </div>
          <div class="flat-card-actions">
              link
          </div>
        </div>
      </div>
    <% end %>
  </div>
</div>
